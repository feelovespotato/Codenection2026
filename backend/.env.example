PORT=3001
APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
# Optional: 64 hex characters. Otherwise generated in backend/data/token.key.
TOKEN_ENCRYPTION_KEY=

# AI: fill any keys you have. Blank keys are skipped. Restart the backend after editing.
# Groq keys come from console.groq.com (not xAI/Grok).
AI_ENABLED=true
AI_PROVIDER_ORDER=groq,openrouter,gemini
AI_TIMEOUT_MS=8000
AI_TOTAL_TIMEOUT_MS=25000
AI_COOLDOWN_MS=60000
AI_REQUESTS_PER_MINUTE=10
# false blocks paid OpenRouter models. Gemini/Groq billing is account-controlled.
AI_ALLOW_PAID_PROVIDERS=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
